{
  "name": "resume",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.6"
  },
  "scripts": {
    "bootstrap": "bun install && bun scripts/install-hooks.ts",
    "check": "bun scripts/check.ts",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "typecheck": "svelte-kit sync && tsc -p scripts/tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:integration": "echo 'integration suite: non-browser integration invariants are colocated *.test.ts executed by test:unit (vitest run); phase 1 has no separate integration project (documented pass-with-no-tests equivalent per NFR Package script categories)'",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage && bun scripts/check-coverage.ts",
    "test:property": "bun scripts/check-property.ts",
    "test:harness": "bun test scripts",
    "check:scenarios": "bun scripts/check-scenarios.ts",
    "check:result": "bun scripts/check-result.ts",
    "check:memory": "bun scripts/check-memory.ts",
    "tdd-commit": "bun scripts/tdd-commit.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.69.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-svelte": "3.20.0",
    "fast-check": "4.8.0",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "marked": "18.0.5",
    "yaml": "2.9.0"
  }
}
