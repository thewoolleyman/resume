{
  "template": "livespec",
  // Gap capture is ACTIVE: revise's post-step capture-impl-gaps surfaces
  // spec->impl gaps for implementation planning to file as work items. Set
  // false only to suppress capture during pre-implementation spec-hardening,
  // when it would otherwise surface the whole spec as unimplemented.
  "post_step_skip_capture_impl_gaps": false,
  // Active implementation orchestrator (the work-item front-end for THIS project).
  // livespec's own operations resolve the work-item routing target from this key —
  // /livespec:doctor's capture-as-work-item disposition, the auto-memory redirect
  // hook, and /livespec:revise's post-step gap check. Harness enablement (in
  // .claude/settings.json) makes the orchestrator's skills available; THIS key is
  // what selects it.
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  // Credential-injection wrapper prefixed to bd-backed CLIs so a bare invocation
  // self-heals its tenant secret (BEADS_DOLT_PASSWORD) by re-exec. resume is an
  // INDEPENDENT tenant (modelled on openbrain), so this names resume's OWN
  // committed repo-root wrapper (backed by the resume 1Password Environment via
  // `op run --environment`), NOT the livespec fleet's with-livespec-env.sh. The
  // relative `./with-resume-env.sh` keeps the reference portable and standalone
  // (the wrapper is committed in-repo per non-functional-requirements.md
  // §"Local secret injection"); os.execvp resolves it from the project-root cwd.
  "credential_wrapper": ["./with-resume-env.sh", "--"],
  // Per-repo beads tenant for resume's work-item tracking. resume is an
  // INDEPENDENT (non-family) tenant on the shared dolt-server: tenant ==
  // database == server_user == "resume", issue-ID prefix "li" (matching the
  // existing li-* ids migrated from the retired JSONL work-items store).
  // Isolation is the per-tenant Dolt SQL user + DB-scoped grant. The
  // tenant password is injected as BEADS_DOLT_PASSWORD by the credential_wrapper
  // above and is NEVER committed here. TCP-only (no socket key: the dolt socket
  // dir is 0750 dolt:dolt, untraversable by non-dolt callers). `fake` is false so
  // the committed config describes the real connection; CI/tests set
  // LIVESPEC_BEADS_FAKE=1 to force the hermetic in-memory backend. Mirrors
  // .beads/config.yaml.
  // Non-interactive propose-change: /livespec:propose-change files its
  // proposal without a per-question dialogue, so an unattended dispatch can
  // drive it. Maintainer-directed fleet-wide autonomy lever rollout; resume is
  // included as an adopter by explicit maintainer confirmation.
  "spec_governance": {
    "propose_change_mode": "batch"
  },
  // Optional — spec_governance: policy levers for livespec's spec-side
  // operations. The commented defaults below are derived from the shipped
  // spec-governance manifest; leaving this block commented arms nothing, so
  // every operation uses the same safe defaults it would use with no
  // spec_governance block at all.
  // To enable any key, add the block as a real key above (a comma after the
  // `harnesses` block) and keep only the entries this repo intentionally
  // overrides:
  //   "spec_governance": {
  //     // propose_change_mode (enum; allowed: "interactive", "batch")
  //     "propose_change_mode": "interactive",
  //     // critique_mode (enum; allowed: "interactive", "batch")
  //     "critique_mode": "interactive",
  //     // in_flight_alignment (enum; allowed: "prompt", "default-align")
  //     "in_flight_alignment": "prompt",
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // revise_decision_mode (enum; allowed: "manual", "delegated",
  //     // "consensus"; per-proposal override: decision_policy)
  //     "revise_decision_mode": "manual",
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_review (enum; allowed: "manual-spawn", "auto-spawn";
  //     // per-proposal override: ratification_review_policy)
  //     "ratification_review": "manual-spawn",
  //     // ratification_reviewer_model (string; no enumerated allowed values)
  //     "ratification_reviewer_model": null,
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1
  //   }
  //
  "livespec-orchestrator-beads-fabro": {
    "format": "beads",
    "compat": {
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.7.1"
    },
    // Acceptance policy, set EXPLICITLY to the fleet standard rather than left
    // to the resolver default: `resolve_acceptance_mode` defaults to
    // "ai-then-human", so a repo that says nothing silently opts OUT of the
    // fleet standard and the omission is indistinguishable from agreement.
    // Maintainer-directed 2026-07-29: every fleet member is "ai-only".
    // `auto_approve_ready` is a DIFFERENT lever (admission, not acceptance);
    // it is set true here as part of the maintainer-directed fleet-wide
    // autonomy lever rollout, which explicitly includes this adopter repo.
    "dispatcher": {
      "wip_cap": 5,
      "acceptance_mode": "ai-only",
      "auto_approve_ready": true,
      "default_factory": "default",
      "factories": {
        "default": {
          "server": "https://vps.perch-rudd.ts.net:32276"
        }
      }
    },
    "connection": {
      "tenant": "resume",
      "prefix": "li",
      "database": "resume",
      "server_user": "resume",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    }
  }
}
