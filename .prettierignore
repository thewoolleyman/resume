# Markdown is governed prose (specs, plans, notes) — formatting it would
# churn spec diffs; it is not part of the format gate.
*.md
# Data and lock records, not source.
bun.lock
# Governed data snapshot: a VERBATIM, byte-identical predecessor import whose
# SHA-256 is pinned (SPECIFICATION/spec.md). Formatting it would break the
# provenance hash, so it is never prettier-governed.
data/
# Tool configuration directories that are not first-party source.
.claude/
.idea/
.githooks/
archive/
# The beads work-item tenant store: config.yaml/.gitignore are committed but
# the rest (metadata.json, the local Dolt dir, runtime files) is tool-managed
# and not prettier-governed source.
.beads/
# livespec config: its strict-JSONC grammar (doctor-livespec-jsonc-valid)
# forbids the trailing commas Prettier's jsonc style would add.
.livespec.jsonc
# Local Playwright MCP browser-session artifacts (untracked scratch).
.playwright-mcp/
