{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-plugin-freshness.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/ensure-plugins.ts\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/footgun-guard.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/background-gate-guard.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-stop-guard.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "livespec@livespec": true,
    "livespec@livespec-driver-claude": true,
    "livespec-orchestrator-beads-fabro@livespec-orchestrator-beads-fabro": true,
    "livespec-overseer@livespec-overseer": true
  },
  "extraKnownMarketplaces": {
    "livespec": {
      "source": {
        "source": "github",
        "repo": "thewoolleyman/livespec",
        "ref": "v0.7.3"
      }
    },
    "livespec-driver-claude": {
      "source": {
        "source": "github",
        "repo": "thewoolleyman/livespec-driver-claude",
        "ref": "v0.2.1"
      }
    },
    "livespec-orchestrator-beads-fabro": {
      "source": {
        "source": "github",
        "repo": "thewoolleyman/livespec-orchestrator-beads-fabro",
        "ref": "v0.13.9"
      }
    },
    "livespec-overseer": {
      "source": {
        "source": "github",
        "repo": "thewoolleyman/livespec-overseer",
        "ref": "v1.18.0"
      }
    }
  }
}
