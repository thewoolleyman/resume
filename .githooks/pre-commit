#!/usr/bin/env bash
# Pre-commit gates, installed by `bun run bootstrap` via core.hooksPath (see
# .githooks/README.md). Each also runs inside `bun run check`, so a bypassed
# or uninstalled hook is still caught.
#
# 1. Primary-checkout commit-refuse (§"Pull request landing automation",
#    worktree-mandatory since v028): reject a commit authored in the primary
#    checkout instead of a secondary worktree, naming the `git worktree add`
#    alternative. Scoped to this repository, so foreign repos borrowing these
#    hooks (test fixtures) are not refused.
# 2. Local memory guardrail: block any commit whose staged tree adds a
#    prohibited private-memory / hidden tool-state path, an unindexed .ai/*.md
#    note, or a dangling AGENTS.md reference.
set -euo pipefail
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bun "$hook_dir/../scripts/check-primary-checkout.ts"
exec bun "$hook_dir/../scripts/check-memory.ts" --staged
